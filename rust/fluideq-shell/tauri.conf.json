{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluidEQ",
  "version": "2.1.0",
  "identifier": "com.fluideq.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FluidEQ",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FluidEQ",
    "copyright": "Copyright (C) 2026 Ivan Carmenates Garcia",
    "category": "Music",
    "shortDescription": "System-wide parametric audio equalizer",
    "longDescription": "FluidEQ is a system-wide parametric audio equalizer for Windows. A Rust shell and state centre drive the original C++ DSP core.",
    "icon": [
      "../../assets/icons/32x32.png",
      "../../assets/icons/128x128.png",
      "../../assets/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
